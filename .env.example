# Copy to .env.local and fill in real values. Never commit .env.local.
# Same Supabase project as the client-facing app — copy the exact
# URL/anon key from that app's .env.local so both sites read/write the
# same database.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# SERVER-SIDE ONLY — never prefix this with VITE_, or it ships to the
# browser. Get it from Supabase Dashboard -> Project Settings -> API ->
# service_role key. Used only by server.ts to send staff invite emails
# and create the matching admin_users row. Rotate this immediately if it
# is ever committed to version control.
SUPABASE_SERVICE_ROLE_KEY=

# Public URL this app is deployed at (used to build the invite/reset
# password email links). Defaults to http://localhost:3001 in dev.
SITE_URL=http://localhost:3001
